#!/bin/sh
# chezmoi onchange script: installs packages based on host OS and shell.
# Layout: packages/<pm>/{core,bash,zsh}.txt (apt/pacman) or .Brewfile (brew).
# Linux installs core + the detected shell's set; macOS (brew) installs core +
# zsh. The script's real exit status is preserved for chezmoi.

set -e

PACKAGES_DIR="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}/packages"
LOG_FILE="${HOME}/.local/share/chezmoi/install-packages.log"

detect_os() {
    case "$(uname -s)" in
        Darwin) echo "darwin" ;;
        Linux)
            if [ -f /etc/os-release ]; then
                . /etc/os-release
                case "$ID" in
                    debian|ubuntu|linuxmint|pop|elementary|zorin) echo "debian" ;;
                    arch|manjaro|endeavouros|cachyos) echo "arch" ;;
                    *) echo "unknown-linux" ;;
                esac
            else
                echo "unknown-linux"
            fi
            ;;
        *) echo "unknown" ;;
    esac
}

detect_shell() {
    case "${SHELL:-}" in
        *zsh) echo "zsh" ;;
        *)    echo "bash" ;;
    esac
}

install_apt() {
    echo "[chezmoi] Installing packages with apt..."
    sudo apt-get update -qq

    for recipe in "core" "$(detect_shell)"; do
        file="$PACKAGES_DIR/apt/$recipe.txt"
        if [ ! -f "$file" ]; then
            echo "  [warn] missing recipe file: $file"
            continue
        fi
        echo "[chezmoi] Installing '$recipe' packages with apt..."
        # shellcheck disable=SC2046,SC2086 # package names are simple, whitespace-free
        if ! sudo apt-get install -y -qq --no-install-recommends $(tr '\n' ' ' < "$file"); then
            echo "  [warn] apt could not install one or more '$recipe' packages"
        fi
    done
}

install_pacman() {
    echo "[chezmoi] Installing packages with pacman..."
    sudo pacman -Syu --noconfirm --needed --quiet

    for recipe in "core" "$(detect_shell)"; do
        file="$PACKAGES_DIR/pacman/$recipe.txt"
        if [ ! -f "$file" ]; then
            echo "  [warn] missing recipe file: $file"
            continue
        fi
        echo "[chezmoi] Installing '$recipe' packages with pacman..."
        # shellcheck disable=SC2046,SC2086 # package names are simple, whitespace-free
        if ! sudo pacman -S --noconfirm --needed $(tr '\n' ' ' < "$file"); then
            echo "  [warn] pacman could not install one or more '$recipe' packages"
        fi
    done
}

install_darwin() {
    echo "[chezmoi] Installing packages with Homebrew..."

    if ! command -v brew >/dev/null 2>&1; then
        echo "[chezmoi] Homebrew not found. Installing Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        if [ -f /opt/homebrew/bin/brew ]; then
            eval "$(/opt/homebrew/bin/brew shellenv)"
        fi
    fi

    for upstreamfile in "core" "zsh"; do
        file="$PACKAGES_DIR/brew/$upstreamfile.Brewfile"
        if [ ! -f "$file" ]; then
            echo "  [warn] missing recipe file: $file"
            continue
        fi
        echo "[chezmoi] Installing '$upstreamfile' packages with Homebrew..."
        if ! brew bundle --file="$file"; then
            echo "  [warn] brew bundle could not install the '$upstreamfile' packages"
        fi
    done
}

main() {
    OS=$(detect_os)
    echo "[chezmoi] Detected OS: $OS"

    case "$OS" in
        debian) install_apt ;;
        arch)   install_pacman ;;
        darwin) install_darwin ;;
        *)
            echo "[chezmoi] OS '$OS' is not supported for automatic package installation."
            echo "[chezmoi] Please install manually: curl git ripgrep fd fzf neovim bash zsh starship zoxide zsh-autosuggestions zsh-syntax-highlighting"
            ;;
    esac

    echo "[chezmoi] Package installation complete."
}

mkdir -p "$(dirname "$LOG_FILE")"
if output=$(main 2>&1); then
    rc=0
else
    rc=$?
fi
printf '%s\n' "$output"
printf '%s\n' "$output" >> "$LOG_FILE"
exit "$rc"
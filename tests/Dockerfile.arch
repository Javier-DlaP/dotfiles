FROM --platform=linux/amd64 archlinux/archlinux:latest

ARG DEFAULT_SHELL=bash
ENV SHELL=/bin/${DEFAULT_SHELL}

RUN echo 'DisableSandbox' >> /etc/pacman.conf && \
    pacman -Syu --noconfirm --quiet && \
    pacman -S --noconfirm --needed sudo curl git && \
    pacman -Scc --noconfirm && \
    yes | pacman -Scc 2>/dev/null || true

RUN curl -fsLS get.chezmoi.io | sh -s -- -b /usr/local/bin

RUN useradd -m -s /bin/bash testuser && \
    echo 'testuser ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

COPY . /tmp/dotfiles

RUN mkdir -p /home/testuser/.local/share && \
    cp -r /tmp/dotfiles /home/testuser/.local/share/chezmoi && \
    chown -R testuser:testuser /home/testuser/.local/share/chezmoi && \
    chown -R testuser:testuser /home/testuser

COPY tests/run-tests.sh /tmp/run-tests.sh
RUN chmod +x /tmp/run-tests.sh

USER testuser
WORKDIR /home/testuser

RUN chezmoi apply --verbose 2>&1 || echo "[test] chezmoi apply completed with warnings"

USER root
RUN if [ "$DEFAULT_SHELL" = zsh ]; then usermod -s "$(command -v zsh)" testuser; fi

USER testuser

CMD ["/tmp/run-tests.sh"]